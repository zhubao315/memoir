# ============ Memoir environment ============
# Copy to .env and fill in. NEVER commit real secrets.

ENVIRONMENT=development
APP_NAME=Memoir
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Security (P0) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production REQUIRES >=32 chars and refuses to start without it.
SECRET_KEY=dev-only-insecure-secret-key-change-me-please-123456
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# ---- CORS (comma separated, no '*' with credentials) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# ---- Database ----
# Dev/test: sqlite:///./memoir.db
# Prod:     postgresql+psycopg://user:pass@postgres:5432/memoir
DATABASE_URL=sqlite:///./memoir.db

# ---- Storage ----
STORAGE_BACKEND=local            # local | s3
LOCAL_STORAGE_DIR=./uploads
S3_ENDPOINT_URL=                 # http://minio:9000 for MinIO
S3_BUCKET=memoir
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MEDIA_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=104857600
MAX_AUDIO_SECONDS=1800
TASK_MAX_RETRIES=3

# ---- AI Providers (no key => deterministic Mock, never fakes a real service) ----
AI_PROVIDER=mock                 # mock | openai_compatible | anthropic_compatible | local
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_STORY=memoir-story-v1
AI_MODEL_FAST=memoir-fast-v1
AI_MODEL_EMBEDDING=memoir-embedding-v1
ASR_PROVIDER=mock                # mock | openai_compatible
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
